{
  "name": "@kan-do/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "migrate:up": "node-pg-migrate up -m migrations",
    "migrate:down": "node-pg-migrate down -m migrations",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/**/*.integration.test.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.1.0",
    "@kan-do/shared": "workspace:*",
    "@node-saml/node-saml": "^5.1.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.11.2",
    "firebase-admin": "^14.2.0",
    "jose": "^6.2.8",
    "kysely": "^0.29.4",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^9.0.5",
    "openid-client": "^6.8.4",
    "pg": "^8.22.0",
    "pg-boss": "^12.27.0",
    "pino": "^10.3.1",
    "rrule": "^2.8.1",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "eslint": "^10.8.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
