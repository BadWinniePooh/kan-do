# --- required ---
SESSION_SECRET=change-me-long-random-string

# ===========================================================================
# LOCAL deployment (docker-compose.yml)
# ===========================================================================

# --- host ports (the left-hand side of each published port) ---
# Change one of these and the matching public URL below follows automatically,
# so long as you leave PUBLIC_URL / S3_PUBLIC_ENDPOINT commented out.
WEB_HOST_PORT=8080
S3_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
POSTGRES_HOST_PORT=55432

# --- public URLs (what browsers can reach) ---
# Only set these to override the defaults derived from the ports above — e.g.
# when reaching the stack over a LAN address or through another proxy.
# PUBLIC_URL=http://localhost:8080
# S3_PUBLIC_ENDPOINT=http://localhost:9000

# ===========================================================================
# PUBLIC deployment behind an existing Traefik (docker-compose.traefik.yml)
# ===========================================================================
# No host ports are published there; the two hostnames below are how the stack
# is reached. Both must resolve to the host running Traefik.

# App hostname; PUBLIC_URL becomes https://$APP_HOST
APP_HOST=kando.example.com
# Object storage hostname. Required and must differ from APP_HOST: browsers
# fetch attachments straight from MinIO through presigned URLs.
S3_HOST=s3.kando.example.com

# Docker network your Traefik already watches — this stack joins it, and it
# must exist beforehand (Traefik is never started by this compose file).
TRAEFIK_NETWORK=traefik
# Traefik entrypoint and certificate resolver names. These refer to your own
# Traefik static configuration; the certresolver must be one it actually
# defines, or routers come up without a certificate.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# ===========================================================================
# Shared by both
# ===========================================================================

# --- database ---
POSTGRES_USER=kando
POSTGRES_PASSWORD=kando
POSTGRES_DB=kando

# --- object storage (MinIO defaults; point at any S3-compatible service) ---
S3_BUCKET=kando
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- email notifications (empty = channel disabled) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=kan-do@example.com

# --- Android push via FCM (path to mounted service-account JSON; empty = disabled) ---
FCM_CREDENTIALS_FILE=

# --- first global admin (created on first start if no users exist) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin1234
